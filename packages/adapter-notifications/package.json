{
  "name": "@parallelplay/adapter-notifications",
  "version": "0.1.0",
  "description": "Desktop and signed-webhook notification adapters for ParallelPlay",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loopback-receiver": {
      "types": "./dist/loopback-receiver.d.ts",
      "import": "./dist/loopback-receiver.js"
