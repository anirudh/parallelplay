  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@parallelplay/contracts": "workspace:*",
    "@homebridge/dbus-native": "0.7.9",
    "zod": "4.4.3"
