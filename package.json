{
  "name": "parallelplay",
  "version": "0.1.0",
  "private": true,
  "description": "Policy-first, local-first control plane for autonomous software delivery",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anirudh/parallelplay.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "sandbox:prepare": "node scripts/sandbox-prepare.mjs",
    "sandbox:check": "node scripts/sandbox-check.mjs",
    "parallelplay": "node apps/cli/dist/main.js",
    "conformance": "vitest run packages/conformance/src",
    "provider-lock:verify": "node scripts/verify-provider-lock.mjs",
    "public:audit": "node scripts/public-audit.mjs",
    "release:build": "pnpm build && node scripts/release/build-release.mjs",
    "release:inspect": "node scripts/release/inspect-release.mjs",
    "release:verify": "pnpm build && node scripts/release/verify-reproducible.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm sandbox:check && pnpm provider-lock:verify && pnpm public:audit && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/release/inspect-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.17.0",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
